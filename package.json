{
  "name": "media-content",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test src/tests/**/*.test.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "knex": "tsx node_modules/knex/bin/cli.js --knexfile knexfile.ts",
    "migrate:up": "npm run knex -- migrate:latest",
    "migrate:down": "npm run knex -- migrate:rollback",
    "migrate:make": "npm run knex -- migrate:make",
    "migrate:fresh": "npm run knex -- migrate:rollback --all && npm run knex -- migrate:latest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}